# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/backtoyou?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=backtoyou_secure_super_secret_jwt_key_2026_change_in_production

# JWT Token Expiration
JWT_EXPIRE=7d

# Allowed Frontend Origins (comma separated if multiple)
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://127.0.0.1:8080
